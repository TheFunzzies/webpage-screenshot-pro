{
  "manifest_version": 3,
  "name": "Webpage Screenshot Pro",
  "version": "0.10.0",
  "minimum_chrome_version": "118",
  "description": "Save a whole web page, the visible area or a region you draw, as a small searchable PDF, a JPEG/PNG image or Markdown text.",
  "permissions": [
    "debugger",
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save full page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Save the full page"
    },
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Capture a region (drag to select)"
    },
    "capture-visible": {
      "description": "Save the visible area"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
